# Gambas Form File 3.0

{ Form Form
  MoveScaled(0,0,73,59)
  Font = Font["12"]
  Text = ("About MiKeyGenerator")
  Icon = Picture["mikeygenerator.png"]
  Resizable = False
  { Label2 Label
    MoveScaled(1,1,66,4)
    #Translate = False
    Font = Font["Bold"]
    Alignment = Align.TopLeft
    Text = "MiKeyGenerator"
  }
  { TextArea1 TextArea
    MoveScaled(1,25,71,28)
    #Translate = False
    Font = Font["11"]
    Text = "MiKeyGenerator is free software: you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, only version 2 of the License.\n\nMiKeyGenerator is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for more details."
    ReadOnly = True
    Wrap = True
    ScrollBar = Scroll.Vertical
  }
  { Label1 Label
    MoveScaled(1,17,66,4)
    #Translate = False
    Alignment = Align.TopLeft
    Text = "Copyright (C) 2024-2026 Murilo Gomes <profmugomes.com.br>"
  }
  { Label3 Label
    MoveScaled(1,9,66,4)
    #Translate = False
    Alignment = Align.TopLeft
    Text = "Developed by: Murilo Gomes"
  }
  { Label4 Label
    MoveScaled(1,12,37,4)
    #Translate = False
    Text = "Site:"
  }
  { URLLabel1 URLLabel
    MoveScaled(6,12,42,4)
    #Translate = False
    Text = "profmugomes.com.br"
  }
  { Label6 Label
    MoveScaled(1,20,30,5)
    #Translate = False
    Text = "License: GPL-2.0-only"
  }
  { Label7 Label
    MoveScaled(1,5,70,3)
    #Translate = False
    Text = "Security key generator."
  }
  { PictureBox1 PictureBox
    MoveScaled(58,4,9,8)
    Picture = Picture.Load("mikeygenerator.png")
    Stretch = True
  }
}
